# ── Configuración de Base de Datos ──
# URI de tu cluster de MongoDB (Atlas o Local) con TLS habilitado
URI_MONGODB=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<db>?appName=RAVAGE


# ── Seguridad y Autenticación ──
# Clave hexadecimal de 32 bytes (64 caracteres hex) para firmar JWT
SECRET_KEY_JWT=

# Clave hexadecimal de 32 bytes (64 caracteres hex) para cifrado local de sesión y ajustes (AES-256)
SECRET_KEY_COKKIE=

# Clave hexadecimal de 32 bytes (64 caracteres hex) para cifrar la identidad (clave privada E2EE) en disco (AES-256)
# Debe ser distinta de SECRET_KEY_COKKIE para aislar el cifrado de la clave privada de mensajes
SECRET_KEY_PRIVATE=

# Clave hexadecimal de 32 bytes (64 caracteres hex) para cifrado at-rest en MongoDB
INTERNAL_ENCRYPTION_KEY=

# ── Servicio de Email (Brevo) ──
# Tu API Key de Brevo (v3)
BREVO_API_KEY=xkeysib-...

# El email verificado de tu cuenta de Brevo que aparecerá como remitente
BREVO_SENDER_EMAIL=tu_correo@ejemplo.com

#API KEY Google Safe Browsing , para detectar enlaces maliciosos
GOOGLE_SAFE_BROWSING_API_KEY=GOOGLE_API_KEY

# ── Servidor Socket.IO en producción (Railway) ──
# Token secreto para autenticar conexiones Socket.IO. Genera con: openssl rand -hex 32
SOCKET_SECRET=

# Origen(es) permitidos para CORS del servidor Railway. Puede ser una URL o lista separada por comas
CLIENT_URL=https://tu-app.com