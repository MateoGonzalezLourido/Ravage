# ── Variables de Entorno Globales ──
# Define el comportamiento global de la aplicación.


# ── Worker Pool Multi-Core ──
# Número de núcleos de CPU a usar para operaciones criptográficas pesadas.
# "none" = automático (CPUs - 1, mínimo 2)
# Un número = usa exactamente esos núcleos (si la CPU los tiene, sino usa máx - 1)
MAX_CPU_CORES_PARALEL=none


# Opciones: true ,false
# Si es true, la aplicación usará logs e intervals para depurar el funcionamiento de la app.
# Si es false, la aplicación bloqueara los intervals y logs (los console.log funcionaran igual).
MODO_DEBUG=true